# Копия этого файла с именем .env читается docker-compose.production.yml.
# Секреты генерируются на своей машине, например:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Этот файл — пример. Настоящий .env в репозиторий не попадает.

# Пароль базы. Внутренний, наружу порт не открыт.
POSTGRES_PASSWORD=

# Секрет подписи токенов сессии. Если сменить — все выданные токены
# перестают действовать, и это правильный способ разлогинить всех.
AUTH_SECRET=

# Пароли демонстрационных учётных записей трёх ролей. Их заводит
# `python -m app.seed_users` при запуске.
FORESTPROOF_OPERATOR_PASSWORD=
FORESTPROOF_INVESTOR_PASSWORD=
FORESTPROOF_ADMIN_PASSWORD=

# Порт, на котором сервис виден снаружи.
HTTP_PORT=80

# Кому разрешено обращаться к API из браузера. Здесь должен стоять
# адрес, по которому открывают сам сервис, — иначе фронт получит отказ
# от собственного API.
CORS_ORIGINS=http://localhost

# Демонстрационный режим: сервис открывается администратором без входа.
# Пусто — выключен. Включается ТОЛЬКО строкой ниже, и только осознанно:
# на публичном адресе это означает, что панель администратора доступна
# любому, кто знает адрес.
#     FORESTPROOF_OPEN_ADMIN=yes-i-know-this-is-public
FORESTPROOF_OPEN_ADMIN=

# Языковая модель для краткой справки. Без ключа справка собирается
# шаблоном — это рабочее состояние, а не поломка.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=deepseek/deepseek-v4-pro-0813
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Токен Earthdata (LP DAAC) для продукта гарей MODIS MCD64A1.
# Без него гари не ищутся, остальной расчёт работает.
EARTHDATA_TOKEN=
