# Адрес бэкенда для расчёта по своему контуру.
#
# Пусто (по умолчанию) — тот же origin: так работает на проде, где nginx
# отдаёт статику и проксирует /api на бэкенд.
#
# Для локальной разработки фронт живёт на 5173, а API на 8000, поэтому
# адрес нужно задать явно: скопируйте этот файл в .env.development
#
#     VITE_API_BASE=http://localhost:8000
#
# Участки набора открываются и без бэкенда — они посчитаны заранее.
# Сервис нужен только для расчёта по своему контуру: предпосчитать
# чужой полигон невозможно.
VITE_API_BASE=
