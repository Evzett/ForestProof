# Языковая модель для краткой справки.
#
# Ключ держится только на сервере. Класть его в сборку фронта нельзя:
# он попадёт в бандл и будет виден всем, кто откроет страницу.
#
# Без ключа сервис работает штатно — справка собирается шаблоном.
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=deepseek/deepseek-v4-pro-0813
ROUTERAI_API_KEY=

# Секрет подписи сессионных токенов (KAN-78).
#
# В репозиторий не попадает и на VPS задаётся переменной окружения.
# Если пусто, секрет генерируется на время жизни процесса: сервис
# поднимется, но после перезапуска все выданные токены станут
# недействительными. Для продакшена задайте явно.
AUTH_SECRET=

# Пароли заранее заведённых учётных записей (python -m app.seed_users).
# Пустое значение — пароль сгенерируется и напечатается один раз.
FORESTPROOF_ANALYST_PASSWORD=
FORESTPROOF_ADMIN_PASSWORD=
